#include <windows.h>

1 ICON "@CMAKE_CURRENT_SOURCE_DIR@/assets/glasslight.ico"
1 RT_MANIFEST "@CMAKE_CURRENT_BINARY_DIR@/glasslight.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK 0x3fL
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Magnus Petursson\0"
      VALUE "FileDescription", "Seeded Vulkan caustic generative-art studio\0"
      VALUE "FileVersion", "@PROJECT_VERSION@\0"
      VALUE "InternalName", "GlassLight\0"
      VALUE "OriginalFilename", "GlassLight.exe\0"
      VALUE "ProductName", "GlassLight\0"
      VALUE "ProductVersion", "@PROJECT_VERSION@\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
